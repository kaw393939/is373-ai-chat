# Public preview: copy to the preview directory as .env with chmod 0600.
DEPLOY_ENV=qa
APP_HOST=qa.firehose360.com
BASE_URL=https://qa.firehose360.com
APP_IMAGE=ghcr.io/kaw393939/is373-ai-chat@<tested-sha256-digest>
JWT_SECRET=<generate-with-openssl-rand-hex-32>
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-32>
TRAEFIK_NETWORK=web
REGISTRATION_POLICY=approval
PROVIDER=mock
EMAIL_PROVIDER=disabled
# Independent Fernet key for optional synthetic MFA; see README configuration.
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false
