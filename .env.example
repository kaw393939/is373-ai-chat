# Copy to .env; generate JWT_SECRET and POSTGRES_PASSWORD with `openssl rand -hex 32`.
APP_ENV=development
BASE_URL=http://localhost:8000
JWT_SECRET=development-only-change-this-key-before-deploying
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://chat:local-development-only@localhost:5432/chat
REGISTRATION_POLICY=approval
PROVIDER=mock
PROVIDER_MODEL=gpt-4.1-mini
PROVIDER_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
PROVIDER_EXPIRES_AT=
APP_HOST=firehose360.com
TRAEFIK_NETWORK=web
# Optional transactional mail. Generate a separate Fernet key with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=accounts@notify.firehose360.com
EMAIL_REPLY_TO=keith@firehose360.com
EMAIL_ENCRYPTION_KEY=
# Use a separate Fernet key for encrypted authenticator secrets. Enable admin
# enforcement only with the matching UI, migrations and owner enrollment plan.
MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false
