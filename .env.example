# Copy to .env; generate JWT_SECRET and POSTGRES_PASSWORD with `openssl rand -hex 32`.
APP_ENV=development
BASE_URL=http://localhost:8000
JWT_SECRET=development-only-change-this-key-before-deploying
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://chat:local-development-only@localhost:5432/chat
REGISTRATION_POLICY=approval
PROVIDER=mock
PROVIDER_MODEL=gpt-4.1-mini
PROVIDER_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
PROVIDER_EXPIRES_AT=
APP_HOST=chat.mywebclass.org
TRAEFIK_NETWORK=web
