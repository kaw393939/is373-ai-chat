#!/usr/bin/env python3
"""Fixed-repository deployer: validate staging before changing the active model."""

import fcntl
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DIGEST = re.compile(r"sha256:[a-f0-9]{64}")
SHA = re.compile(r"[a-f0-9]{40}")
REPOSITORY = "ghcr.io/kaw393939/is373-ai-chat"


def policy_module():
    installed = Path("/usr/local/lib/chat-release-policy.py")
    source = installed if installed.exists() else Path(__file__).with_name("release_policy.py")
    spec = importlib.util.spec_from_file_location("release_policy", source)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def atomic_write(path, value):
    """Create private bytes first; readers see only the complete replacement."""
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            os.chmod(temporary, 0o600)
            stream.write(value)
            stream.flush()
            os.fsync(stream.fileno())
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


class Runner:
    def __init__(self, environment):
        self.environment = environment

    def __call__(self, args, timeout=180, **kwargs):
        result = subprocess.run(
            args, env=self.environment, capture_output=True, timeout=timeout, **kwargs
        )
        if result.returncode:
            # Never expose provider/config/registry output through workflow logs.
            raise RuntimeError("Command failed: " + " ".join(args[:2]))
        return result.stdout


def schema(run, compose):
    prefix = compose + ["exec", "-T", "db", "psql", "-U", "chat", "-d", "chat", "-Atc"]
    exists = run(prefix + ["SELECT to_regclass('public.alembic_version')"]).decode().strip()
    return (
        run(prefix + ["SELECT version_num FROM alembic_version"]).decode().strip() if exists else ""
    )


def health(run, compose):
    return json.loads(
        run(
            compose
            + [
                "exec",
                "-T",
                "app",
                "python",
                "-c",
                "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=5).read().decode())",
            ]
        )
    )


def deploy(root, image, commit, run, environment, version=None, stage="production", run_id=None):
    """Recover setup failures; never auto-downgrade a schema-changing release."""
    env_file = root / ".env"
    if not env_file.is_file() or env_file.stat().st_mode & 0o077:
        raise ValueError("Protect deployment .env with mode 0600")
    old_compose = (root / "compose.yaml").read_bytes() if (root / "compose.yaml").exists() else None
    old_record = (root / "release.json").read_bytes() if (root / "release.json").exists() else None
    old_current = (
        (root / "current-image").read_bytes() if (root / "current-image").exists() else None
    )
    old_image = old_current.decode().strip() if old_current else ""
    before, changed, phase = None, False, "extract"
    backup = root / "backups"
    backup.mkdir(mode=0o700, exist_ok=True)
    attempt = {
        "status": "failed",
        "commit": commit,
        "image": image,
        "version": version,
        "environment": stage,
        "run_id": run_id,
        "at": time.time(),
    }
    with tempfile.TemporaryDirectory(prefix="candidate-", dir=root) as directory:
        candidate = Path(directory) / "compose.yaml"
        compose = ["docker", "compose", "--project-directory", str(root), "-f", str(candidate)]
        active = [
            "docker",
            "compose",
            "--project-directory",
            str(root),
            "-f",
            str(root / "compose.yaml"),
        ]
        environment["APP_IMAGE"] = image
        try:
            probe = run(["docker", "create", image]).decode().strip()
            try:
                model = "compose.yaml" if stage == "production" else "compose.preview.yaml"
                run(["docker", "cp", probe + ":/app/deploy/" + model, str(candidate)])
            finally:
                run(["docker", "rm", probe])
            phase = "validate"
            run(compose + ["config", "--quiet"])
            phase = "database"
            changed = True
            run(compose + ["up", "-d", "--wait", "--wait-timeout", "90", "db"])
            before = schema(run, compose)
            phase = "backup"
            dump = run(compose + ["exec", "-T", "db", "pg_dump", "-U", "chat", "-d", "chat", "-Fc"])
            if not dump:
                raise RuntimeError("Empty database backup")
            path = backup / (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + ".dump")
            atomic_write(path, dump)
            attempt["backup"] = path.name
            phase = "migration"
            atomic_write(root / "compose.yaml", candidate.read_bytes())
            run(active + ["run", "--rm", "--no-deps", "app", "alembic", "upgrade", "head"])
            run(active + ["run", "--rm", "--no-deps", "app", "python", "-m", "app.cli", "seed"])
            phase = "readiness"
            run(active + ["up", "-d", "--no-deps", "--wait", "--wait-timeout", "90", "app"])
            observed = health(run, active)
            if observed["commit"] != commit or observed["schema"] != schema(run, active):
                raise RuntimeError("Running release identity mismatch")
            if version is not None and observed.get("version") != version:
                raise RuntimeError("Running release version mismatch")
            if stage != "production" and observed.get("provider") != "mock":
                raise RuntimeError("Preview provider must be mock")
            phase = "record"
            record = {
                "status": "deployed",
                "image": image,
                "commit": commit,
                "version": version,
                "environment": stage,
                "run_id": run_id,
                "schema": observed["schema"],
                "previous_schema": before,
                "backup": attempt["backup"],
                "recovery": "previous image only when schema unchanged; otherwise operator restore",
                "deployed_at": time.time(),
            }
            atomic_write(root / "current-image", (image + "\n").encode())
            atomic_write(root / "release.json", json.dumps(record).encode())
            for stale in sorted(backup.glob("*.dump"))[:-14]:
                stale.unlink()
            return record
        except Exception:
            attempt["phase"] = phase
            try:
                after = before
                if changed:
                    try:
                        after = schema(run, compose)
                    except Exception:
                        after = None
                attempt["schema_before"], attempt["schema_after"] = before, after
                safe = phase in {"database", "backup"} or (before is not None and before == after)
                if old_compose and old_image and safe:
                    atomic_write(root / "compose.yaml", old_compose)
                    environment["APP_IMAGE"] = old_image
                    if changed:
                        run(active + ["up", "-d", "--wait", "--wait-timeout", "90", "db", "app"])
                    if old_current:
                        atomic_write(root / "current-image", old_current)
                    if old_record:
                        atomic_write(root / "release.json", old_record)
                    attempt["recovery"] = "previous-release-restored"
                elif not changed:
                    attempt["recovery"] = "active-release-unchanged"
                else:
                    # Running an old app against a changed/unknown schema is unsafe.
                    run(compose + ["stop", "app"])
                    if old_compose:
                        atomic_write(root / "compose.yaml", old_compose)
                    atomic_write(
                        root / "release.json", json.dumps({**attempt, "status": "blocked"}).encode()
                    )
                    attempt["recovery"] = "operator-required-app-stopped"
            except Exception:
                attempt["recovery"] = "operator-required-recovery-failed"
                atomic_write(
                    root / "release.json", json.dumps({**attempt, "status": "blocked"}).encode()
                )
            atomic_write(root / "last-attempt.json", json.dumps(attempt).encode())
            raise RuntimeError(
                "Deployment failed during " + phase + "; " + attempt["recovery"]
            ) from None


def main(arguments=None):
    arguments = sys.argv[1:] if arguments is None else arguments
    policy = policy_module()
    if len(arguments) != 5:
        raise SystemExit("Expected a scoped release command")
    operation = arguments[0]
    if operation == "deploy" and arguments[1] in {"dev", "qa"}:
        stage = arguments[1]
        expected = policy.identity(*arguments[2:])
        number = None
    elif operation in {"attest", "promote"}:
        stage = "qa" if operation == "attest" else "production"
        expected = policy.identity(*arguments[1:4])
        number = policy.run_id(arguments[4])
    else:
        raise SystemExit("Unsupported release operation or environment")
    root = policy.ROOTS[stage]
    root.mkdir(mode=0o700, exist_ok=True)
    # One shared host has one release critical section, including QA attestation.
    state = Path("/var/lib/chat-release")
    state.mkdir(mode=0o700, exist_ok=True)
    if state.stat().st_uid != 0 or state.stat().st_mode & 0o077:
        raise SystemExit("Release lock directory must be root-owned mode 0700")
    with open(state / "deploy.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        os.chmod(lock.name, 0o600)
        credential = sys.stdin.readline().strip()
        if not credential:
            raise SystemExit("Registry pull credential required")
        environment = os.environ.copy()
        environment["DEPLOY_ENV"] = stage
        environment["APP_IMAGE"] = expected["image"]
        api = policy.GitHub(credential)
        if operation == "attest":
            policy.verify_run(api, number, expected, finished=False)
            current = json.loads((root / "release.json").read_text())
            if current.get("status") != "deployed" or not policy.matches(current, expected):
                raise SystemExit("QA release identity mismatch")
            observed = health(
                Runner(environment),
                [
                    "docker",
                    "compose",
                    "--project-directory",
                    str(root),
                    "-f",
                    str(root / "compose.yaml"),
                ],
            )
            if (
                any(
                    observed.get(key) != current.get(key) for key in ("commit", "version", "schema")
                )
                or observed.get("provider") != "mock"
            ):
                raise SystemExit("QA health identity mismatch")
            record = {
                **expected,
                "status": "accepted",
                "schema": current["schema"],
                "run_id": number,
                "accepted_at": time.time(),
            }
            atomic_write(root / "qa-attestation.json", json.dumps(record).encode())
            print(json.dumps(record))
            return
        history_path = root / "version-history.json"
        history = json.loads(history_path.read_text()) if history_path.exists() else {}
        if operation == "promote":
            if (root / "release.json").exists():
                previous = json.loads((root / "release.json").read_text())
                if previous.get("status") == "deployed" and previous.get("version"):
                    history.setdefault(previous["version"], previous)
            policy.promotion(api, number, expected, policy.ROOTS["qa"], history)
        with tempfile.TemporaryDirectory(prefix="chat-registry-") as auth:
            environment["DOCKER_CONFIG"] = auth
            run = Runner(environment)
            run(
                ["docker", "login", "ghcr.io", "-u", "kaw393939", "--password-stdin"],
                input=credential.encode(),
            )
            image = expected["image"]
            run(["docker", "pull", image])
            label = (
                run(
                    [
                        "docker",
                        "image",
                        "inspect",
                        image,
                        "--format",
                        '{{index .Config.Labels "org.opencontainers.image.revision"}}',
                    ]
                )
                .decode()
                .strip()
            )
            if label != expected["commit"]:
                raise SystemExit("Image source commit mismatch")
            label_version = (
                run(
                    [
                        "docker",
                        "image",
                        "inspect",
                        image,
                        "--format",
                        '{{index .Config.Labels "org.opencontainers.image.version"}}',
                    ]
                )
                .decode()
                .strip()
            )
            embedded = (
                run(
                    [
                        "docker",
                        "run",
                        "--rm",
                        "--network",
                        "none",
                        "--entrypoint",
                        "cat",
                        image,
                        "/app/VERSION",
                    ]
                )
                .decode()
                .strip()
            )
            if label_version != expected["version"] or embedded != expected["version"]:
                raise SystemExit("Image version mismatch")
            record = deploy(
                root,
                image,
                expected["commit"],
                run,
                environment,
                expected["version"],
                stage,
                number,
            )
            if operation == "promote":
                history[expected["version"]] = record
                atomic_write(history_path, json.dumps(history).encode())
            print(json.dumps(record))


if __name__ == "__main__":
    main()
